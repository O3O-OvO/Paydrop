{
  "name": "paydrop",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test src/*.test.js electron/*.test.cjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && node scripts/package-windows.cjs",
    "pack:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0"
  }
}
